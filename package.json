{
  "name": "codex-antigravity-mcp",
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/**/*.test.ts",
    "validate:plugin": "python3 ${HOME}/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py plugin",
    "install:plugin": "npm run build && node scripts/deploy-plugin.mjs",
